{
  "name": "s-kaupat-mcp",
  "version": "1.0.0",
  "description": "MCP server for the S-kaupat.fi grocery store",
  "type": "module",
  "bin": {
    "s-kaupat-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/test",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "pack:extension": "node scripts/pack-extension.mjs",
    "export:tools": "node scripts/export-tools.mjs",
    "build:standalone": "node scripts/build-standalone.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "private": true,
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "playwright-core": "^1.56.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.10",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.9.3"
  },
  "main": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    },
    "./package.json": "./package.json"
  }
}
